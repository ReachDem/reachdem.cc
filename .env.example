# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload — obligatoire
# Générer avec : openssl rand -base64 32
PAYLOAD_SECRET=
# Postgres. En local : une base jetable ; en prod : Cloud SQL (IP privée).
DATABASE_URL=

# Médias — optionnel.
# Sans ces quatre variables, Payload écrit les fichiers en local et l'admin démarre quand même.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mesure — facultatif.
# Sans NEXT_PUBLIC_GTM_ID, aucun script de mesure n'est chargé.
# landing.reachdem.cc : GTM-KV3P3MK3 / G-CPQC101HSD. L'apex garde les siens pour le cutover.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
